{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"C:/Users/刘方林/.claude/skills/superpowers/hooks/session-start\"",
            "async": false
          }
        ]
      }
    ],
    "ToolStart": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/tool-start.sh",
            "async": true
          }
        ]
      }
    ],
    "ToolEnd": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/tool-end.sh",
            "async": true
          }
        ]
      }
    ]
  },
  "_说明": "Claude Code Hook 配置",
  "_文档": "https://code.claude.com/docs/en/hooks",
  "_事件类型": "SessionStart, MessageStart, ToolStart, ToolEnd, Notification",
  "_matcher": "用于匹配事件，可以是正则表达式或具体事件名"
}
