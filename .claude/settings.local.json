{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(npm *)",
      "Bash(pip *)",
      "Bash(python *)",
      "Bash(node *)",
      "Bash(curl *)",
      "Bash(timeout *)",
      "Bash(tree *)",
      "Bash(ls *)",
      "Bash(dir *)",
      "Bash(claude *)",
      "Bash(findstr *)",
      "Bash(tasklist *)",
      "Bash(schtasks *)",
      "Bash(wmic *)",
      "Bash(netstat *)",
      "Bash(export *)",
      "Bash(cat *)",
      "Bash(powershell *)",
      "Bash(winget *)",
      "Bash(cc-switch *)",
      "Bash(docker *)",
      "Bash(kubectl *)",
      "mcp__playwright__*",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:docs.openclaw.dev)",
      "WebFetch(domain:docs.openclaw.ai)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:mp.weixin.qq.com)",
      "WebFetch(domain:help.aliyun.com)",
      "WebFetch(domain:claude.com)",
      "WebFetch(domain:anthropic.com)",
      "Read(//e/桌面/leo_ai_system/**)",
      "Read(//e/.claude//**)",
      "Bash(git config *)"
    ],
    "ask": [
      "Bash",
      "Edit",
      "Write"
    ],
    "deny": [
      "Bash(rm -rf / *)",
      "Bash(format:*)",
      "Read(//c/Users/*/.env)",
      "Read(//c/Users/*/secrets/**)"
    ],
    "additionalDirectories": [
      "e:\\桌面\\leo_ai_system"
    ],
    "defaultMode": "ask"
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "playwright",
    "leo-system",
    "leo-web-search"
  ],
  "language": "chinese",
  "effortLevel": "high",
  "autoUpdatesChannel": "latest",
  "defaultMode": "ask",
  "launchFlags": [
    "--verbose",
    "--debug-file .claude/debug.log"
  ],
  "sandbox": {
    "enabled": true,
    "filesystem": "isolated",
    "network": "denylist"
  },
  "env": {
    "CLAUDE_CODE_DEBUG_LOGS_DIR": ".claude/logs",
    "CLAUDE_REMOTE_CONTROL_SESSION_NAME_PREFIX": "leo"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"C:/Users/刘方林/.claude/skills/superpowers/hooks/session-start\"",
            "async": false
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/tool-start.sh",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/tool-end.sh",
            "async": true
          }
        ]
      }
    ]
  }
}
