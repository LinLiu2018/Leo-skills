# AI 技术情报系统 - 环境变量配置模板
# ================================================
# 复制此文件为 .env 并填入实际的 API 密钥

# Twitter API 配置
# ----------------
# 申请地址：https://developer.twitter.com/
# 需要创建 Developer Account 并创建 App
TWITTER_BEARER_TOKEN=your_bearer_token_here
TWITTER_API_KEY=your_api_key_here
TWITTER_API_SECRET=your_api_secret_here
TWITTER_ACCESS_TOKEN=your_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_access_token_secret_here

# Claude API 配置
# ----------------
# 用于技术识别和代码生成
# 申请地址：https://console.anthropic.com/
CLAUDE_API_KEY=your_claude_api_key_here

# 数据库配置
# ----------
DATABASE_URL=sqlite:///data/tech_intelligence.db

# 日志配置
# --------
LOG_LEVEL=INFO
LOG_FILE=logs/tech_intelligence.log

# 技术情报系统配置
# ----------------
# 是否使用 LLM 进行深度分析（会产生 API 费用）
USE_LLM_ANALYSIS=true

# 是否自动生成代码（建议先设为 false，手动审核后再启用）
AUTO_GENERATE_CODE=false

# 监控频率（Cron 表达式）
MONITORING_SCHEDULE="0 8,20 * * *"

# 时区
TIMEZONE="Asia/Shanghai"
