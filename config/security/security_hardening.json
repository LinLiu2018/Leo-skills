{
  "meta": {
    "version": "1.0.0",
    "created_at": "2026-02-28",
    "updated_at": "2026-02-28",
    "based_on": "OpenClaw 2026.2.23 Security Guidelines"
  },
  "security_settings": {
    "hsts": {
      "enabled": true,
      "maxAge": 31536000,
      "includeSubdomains": true,
      "preload": true
    },
    "cors": {
      "enabled": true,
      "allowedOrigins": ["http://localhost:18788", "http://127.0.0.1:18788"],
      "allowedMethods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
      "allowedHeaders": ["Content-Type", "Authorization", "X-API-Key"],
      "exposeHeaders": ["X-Request-ID"],
      "credentials": true,
      "maxAge": 86400
    },
    "rate_limit": {
      "enabled": true,
      "windowMs": 900000,
      "max": 100,
      "message": "Too many requests, please try again later.",
      "standardHeaders": true,
      "legacyHeaders": false
    },
    "helmet": {
      "enabled": true,
      "contentSecurityPolicy": {
        "directives": {
          "defaultSrc": ["'self'"],
          "scriptSrc": ["'self'"],
          "styleSrc": ["'self'", "'unsafe-inline'"],
          "imgSrc": ["'self'", "data:", "https:"],
          "connectSrc": ["'self'", "https://api.aigocode.cn", "https://api.deepseek.com"],
          "fontSrc": ["'self'"],
          "objectSrc": ["'none'"],
          "mediaSrc": ["'self'"],
          "frameSrc": ["'none'"]
        }
      },
      "crossOriginEmbedderPolicy": true,
      "crossOriginOpenerPolicy": true,
      "crossOriginResourcePolicy": true,
      "dnsPrefetchControl": true,
      "frameguard": true,
      "hidePoweredBy": true,
      "hsts": true,
      "ieNoOpen": true,
      "noSniff": true,
      "originAgentCluster": true,
      "permittedCrossDomainPolicies": true,
      "referrerPolicy": true,
      "xssFilter": true
    },
    "audit_logging": {
      "enabled": true,
      "logLevel": "info",
      "logFile": "logs/security_audit.log",
      "logRotation": "daily",
      "retentionDays": 90,
      "logEvents": [
        "authentication",
        "authorization",
        "api_access",
        "model_access",
        "skill_execution",
        "file_access",
        "browser_access",
        "cron_execution",
        "configuration_change",
        "security_event"
      ]
    },
    "authentication": {
      "sessionTimeout": 3600000,
      "maxSessions": 5,
      "passwordPolicy": {
        "minLength": 12,
        "requireUppercase": true,
        "requireLowercase": true,
        "requireNumbers": true,
        "requireSpecialChars": true,
        "maxAge": 7776000
      },
      "mfa": {
        "enabled": false,
        "provider": "totp",
        "issuer": "Leo AI System"
      }
    },
    "api_security": {
      "apiKeyRotation": {
        "enabled": true,
        "rotationDays": 90
      },
      "apiKeyHash": "sha256",
      "requestSigning": {
        "enabled": true,
        "algorithm": "hmac-sha256"
      }
    },
    "data_protection": {
      "encryption": {
        "algorithm": "aes-256-gcm",
        "keyRotation": true,
        "rotationDays": 30
      },
      "pii_detection": {
        "enabled": true,
        "redaction": true
      },
      "data_retention": {
        "logs": 90,
        "sessions": 30,
        "models": 365
      }
    },
    "vulnerability_protection": {
      "cve_2026_25253": {
        "patched": true,
        "description": "Skill markdown file injection vulnerability",
        "mitigation": "Validate and sanitize skill markdown content, block external URLs"
      },
      "skill_sandbox": {
        "enabled": true,
        "allowedPaths": ["workspace", "temp"],
        "blockedCommands": ["rm -rf", "sudo", "chmod 777", "curl", "wget"],
        "networkAccess": "whitelist"
      },
      "input_validation": {
        "enabled": true,
        "maxInputLength": 100000,
        "sanitizeHtml": true,
        "blockScriptTags": true
      }
    }
  },
  "monitoring": {
    "alerting": {
      "enabled": true,
      "channels": ["feishu"],
      "alerts": {
        "failed_login_threshold": {
          "threshold": 5,
          "window": 300,
          "action": "block_ip"
        },
        "api_rate_limit": {
          "threshold": 100,
          "window": 900,
          "action": "notify"
        },
        "skill_execution_error": {
          "threshold": 10,
          "window": 60,
          "action": "notify"
        },
        "unauthorized_access": {
          "threshold": 1,
          "window": 60,
          "action": "block_ip"
        }
      }
    },
    "dashboard": {
      "enabled": true,
      "refreshInterval": 30,
      "metrics": [
        "request_count",
        "error_rate",
        "response_time",
        "active_sessions",
        "skill_executions",
        "model_usage",
        "security_events"
      ]
    }
  }
}
