{
  "$schema": "https://openclaw.github.io/schema/2026.1.30/config.json",
  "meta": {
    "lastTouchedVersion": "2026.1.30",
    "lastTouchedAt": "2026-02-03T15:00:00.000Z",
    "_comment": "标准配置模板，禁止 AI 自动修改此配置"
  },
  "wizard": {
    "completed": true
  },
  "models": {
    "mode": "merge",
    "providers": {
      "zhipu": {
        "baseUrl": "https://open.bigmodel.cn/api/paas/v4",
        "api": "openai-completions",
        "models": [
          {
            "id": "glm-4-plus",
            "name": "GLM-4 Plus",
            "contextWindow": 128000,
            "maxTokens": 4096
          },
          {
            "id": "glm-4-flash",
            "name": "GLM-4 Flash",
            "contextWindow": 128000,
            "maxTokens": 4096
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "minimax/MiniMax-M2.1"
      }
    },
    "list": [
      {
        "id": "leo-assistant",
        "name": "Leo Assistant",
        "identity": {
          "kind": "inline",
          "content": "你是 Leo AI System 的助手，可以调用 46 个 Skills、14 个 Agents 和 8 个 Workflows。"
        },
        "workspace": "D:/桌面/leo_ai_system"
      }
    ]
  },
  "messages": {
    "ackReactionScope": "group-mentions"
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto",
    "restart": true
  },
  "channels": {
    "feishu": {
      "enabled": true,
      "appId": "${env:FISHU_APP_ID}",
      "appSecret": "${env:FISHU_APP_SECRET}",
      "domain": "feishu",
      "connectionMode": "websocket",
      "dmPolicy": "open",
      "groupPolicy": "open",
      "requireMention": false,
      "blockStreaming": true
    }
  },
  "gateway": {
    "port": 18789,
    "mode": "local",
    "auth": {
      "token": "${env:OPENCLAW_TOKEN}"
    }
  },
  "skills": {
    "load": {
      "extraDirs": [
        "D:\\桌面\\leo_ai_system\\src\\leo_skills"
      ],
      "watch": true,
      "watchDebounceMs": 250
    }
  },
  "plugins": {
    "entries": {
      "feishu": {
        "enabled": true
      },
      "leo-system": {
        "enabled": true,
        "config": {
          "mcpServerPath": "D:/桌面/leo_ai_system/.mcp/leo_mcp_server.py"
        }
      }
    }
  },
  "_protection": {
    "_comment": "以下配置键禁止手动修改，否则会导致 Gateway 启动失败",
    "forbiddenKeys": [
      "mcpServers",
      "agents.defaults.mcpTools",
      "agents.list.*.mcpTools",
      "agents.list.*.systemPrompt",
      "agents.list.*.identity (作为字符串)",
      "cron",
      "plugins.entries (手动修改)"
    ],
    "safeModificationMethods": [
      "node openclaw.mjs config set {key} {value}",
      "node openclaw.mjs doctor --fix"
    ]
  }
}
