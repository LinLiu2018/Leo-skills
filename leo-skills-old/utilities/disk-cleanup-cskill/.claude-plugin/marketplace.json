{
  "name": "disk-cleanup-cskill",
  "version": "1.0.0",
  "type": "skill",
  "description": "Windows disk cleanup and space management skill with safety-first approach. Analyze disk usage, clean temp files, find large files, detect duplicates, and free up space safely.",
  "author": "Leo Liu",
  "keywords": [
    "disk-cleanup",
    "space-analyzer",
    "temp-cleaner",
    "duplicate-finder",
