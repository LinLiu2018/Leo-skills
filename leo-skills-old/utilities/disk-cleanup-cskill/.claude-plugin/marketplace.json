    "system-maintenance",
    "清理硬盘",
    "磁盘清理",
    "空间管理"
  ],

  "activation": {
    "keywords": [
      "清理硬盘",
      "磁盘清理",
      "清理C盘",
      "清理D盘",
      "释放空间",
      "删除临时文件",
      "查找大文件",
      "重复文件",
      "清空回收站",
      "硬盘空间不足",
      "磁盘分析",
      "disk cleanup",
      "clean disk",
      "free space",
      "temp files",
      "large files"
    ],
    "patterns": [
      "(?i)(清理|清除|删除)\\s*(硬盘|磁盘|C盘|D盘)",
      "(?i)(释放|腾出)\\s*空间",
      "(?i)(查找|扫描)\\s*(大文件|重复文件)",
      "(?i)硬盘\\s*(满了|不够|空间不足)",
      "(?i)(分析|检查)\\s*磁盘\\s*使用",
      "(?i)(clean|cleanup|clear)\\s*(disk|drive|storage)",
      "(?i)(free|release)\\s*space",
      "(?i)(find|scan)\\s*(large|duplicate)\\s*files"
    ],
    "context_triggers": [
      "disk space low",
      "storage full",
      "C drive full",
      "need more space",
      "电脑空间不够",
      "硬盘快满了"
    ]
  },

  "capabilities": [
    "disk-space-analysis",
    "temp-file-cleanup",
    "large-file-scanning",
    "duplicate-detection",
    "recycle-bin-cleanup",
    "system-log-cleanup",
    "safety-verification",
    "batch-operations",
    "cleanup-recommendations"
  ],

  "safety_features": [
    "whitelist-protection",
    "blacklist-filtering",
    "confirmation-required",
    "dry-run-mode",
    "send2trash-integration",
    "system-file-protection",
    "rollback-support"
  ],

  "dependencies": {
    "python": ">=3.9",
    "platform": "win32",
    "pip": [
      "psutil>=5.9.0",
      "send2trash>=1.8.0",
      "xxhash>=3.0.0",
      "tqdm>=4.65.0",
      "pyyaml>=6.0"
    ]
  },

  "metadata": {
    "category": "utilities",
