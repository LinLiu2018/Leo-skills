<!--pages/index/index.wxml-->
<view class="container">
  <!-- 顶部Banner -->
  <view class="banner">
    <view class="banner-placeholder"></view>
    <view class="banner-overlay">
      <text class="banner-title">建华观园菜场</text>
      <text class="banner-subtitle">菜场摊位 · 8-13万/个</text>
    </view>
  </view>

  <!-- 限时挑战通知 -->
  <view class="challenge-banner" bindtap="goToShare">
    <image class="challenge-icon" src="https://placehold.co/40x40/FF6B35/white?text=!" mode="aspectFit"></image>
    <view class="challenge-content">
      <text class="challenge-title">限时挑战进行中</text>
      <text class="challenge-desc">24小时内邀15人，赢取100元超市卡！</text>
    </view>
    <view class="challenge-timer">
      <text>{{challengeTime || '去参与 ›'}}</text>
    </view>
  </view>

  <!-- 项目亮点 -->
  <view class="highlights">
    <view class="highlight-item">
      <text class="highlight-value">8-13万</text>
      <text class="highlight-label">总价区间</text>
    </view>
    <view class="highlight-item">
      <text class="highlight-value">7%起</text>
      <text class="highlight-label">预期收益</text>
    </view>
    <view class="highlight-item">
      <text class="highlight-value">14万+</text>
      <text class="highlight-label">周边人口</text>
    </view>
  </view>

  <!-- 实时领取动态 (弹幕样式) -->
  <view class="dynamics-bar">
    <view class="dynamics-icon">🔥</view>
    <swiper class="dynamics-swiper" vertical autoplay circular interval="2000" style="height: 40rpx;">
      <swiper-item wx:for="{{dynamics}}" wx:key="index">
        <view class="dynamics-text">
          <text class="highlight">{{item.name}}</text> 刚刚领取了 <text class="highlight">{{item.gift}}</text>
        </view>
      </swiper-item>
    </swiper>
  </view>

  <!-- 产品介绍 -->
  <view class="product-intro card">
    <view class="section-title">产品介绍</view>

    <view class="intro-item">
      <image class="intro-img" src="https://placehold.co/120x120?text=Store" mode="aspectFill"></image>
      <view class="intro-content">
        <text class="intro-title">菜场业态展示</text>
        <text class="intro-desc">生鲜蔬果、肉禽水产、干货调料等多元业态，满足周边居民一站式采购需求</text>
      </view>
    </view>

    <view class="intro-item">
      <image class="intro-img" src="https://placehold.co/120x120?text=Value" mode="aspectFill"></image>
      <view class="intro-content">
        <text class="intro-title">项目优势</text>
        <text class="intro-desc">低总价、高回报、统一运营管理，投资门槛低收益稳定</text>
      </view>
    </view>

    <view class="intro-item">
      <image class="intro-img" src="https://placehold.co/120x120?text=Traffic" mode="aspectFill"></image>
      <view class="intro-content">
        <text class="intro-title">周边社区流量</text>
        <text class="intro-desc">辐射14万+常住人口，周边多个成熟社区，客流量有保障</text>
      </view>
    </view>
  </view>

  <!-- 视频展示 -->
  <view class="video-section card" wx:if="{{videoUrl}}">
    <view class="section-title">项目视频</view>
    <video
      class="project-video"
      src="{{videoUrl}}"
      poster="{{videoPoster}}"
      controls
      show-center-play-btn
      object-fit="cover"
    ></video>
  </view>

  <!-- 图片展示 -->
  <view class="gallery-section card" wx:if="{{galleryImages.length > 0}}">
    <view class="section-title">项目实景</view>
    <swiper class="gallery-swiper" indicator-dots autoplay circular>
      <swiper-item wx:for="{{galleryImages}}" wx:key="index">
        <image class="gallery-image" src="{{item}}" mode="aspectFill" bindtap="previewImage" data-src="{{item}}"></image>
      </swiper-item>
    </swiper>
  </view>

  <!-- 一键领取礼品 -->
  <view class="gift-section card">
    <view class="gift-header">
      <image class="gift-header-icon" src="https://placehold.co/60x60/FF6B35/white?text=Gift" mode="aspectFit"></image>
      <text class="gift-title">扫码领礼品</text>
      <text class="gift-count" wx:if="{{isLogin}}">已邀请 {{inviteCount}} 人</text>
    </view>

    <view class="gift-desc">
      {{isLogin ? '邀请好友解锁更多礼品' : '授权即可领取精美礼品'}}
    </view>

    <!-- 礼品展示 -->
    <view class="gift-grid">
      <view
        class="gift-card {{item.status}}"
        wx:for="{{giftList}}"
        wx:key="id"
        bindtap="goToGiftDetail"
        data-id="{{item.id}}"
      >
        <view class="gift-img-wrapper">
          <image class="gift-card-img" src="https://minimax-algeng-chat-tts.oss-cn-wulanchabu.aliyuncs.com/ccv2%2F2026-01-29%2FMiniMax-M2.1%2F2007435025913487546%2Fcc93a2a28346b24744c11b2d530e966b186ef4ebfbe7050b01bcdd510eb40870..png?Expires=1769744971&OSSAccessKeyId=LTAI5tGLnRTkBjLuYPjNcKQ8&Signature=NNWXQq3CpvkHRFSThimooVZQfuI%3D" mode="widthFix"></image>
          <view class="gift-status-overlay" wx:if="{{item.status === 'claimed'}}">
            <view class="status-badge claimed">已领取</view>
          </view>
          <view class="gift-status-overlay" wx:elif="{{item.status === 'unlocked'}}">
            <view class="status-badge unlocked">可领取</view>
          </view>
        </view>
        <text class="gift-name">{{item.name}}</text>
        <text class="gift-condition">{{item.condition}}</text>
        <view class="gift-progress-mini" wx:if="{{item.status === 'locked' && item.progress > 0}}">
          <view class="progress-track">
            <view class="progress-fill" style="width: {{item.progress}}%"></view>
          </view>
          <text class="progress-text">{{item.progress}}%</text>
        </view>
      </view>
    </view>

    <!-- 一键领取按钮 -->
    <button
      class="btn-claim"
      open-type="getPhoneNumber"
      bindgetphonenumber="onGetPhone"
      wx:if="{{!isLogin}}"
    >
      一键领取礼品
    </button>

    <!-- 已登录用户的分享引导 -->
    <view class="share-guide" wx:if="{{isLogin}}">
      <button class="btn-share" open-type="share">
        分享给好友，解锁更多礼品
      </button>
      <button class="btn-test" bindtap="testAddInvite" size="mini">
        [测试] 模拟邀请+1
      </button>
    </view>
  </view>


  <!-- 咨询入口 -->
  <view class="contact-section card">
    <view class="section-title" style="margin-bottom: 20rpx;">联系顾问</view>
    <view class="contact-list">
      <view class="contact-item" wx:for="{{contacts}}" wx:key="phone" style="display: flex; justify-content: space-between; align-items: center; padding: 20rpx 0; border-bottom: 1px solid #eee;">
        <view class="contact-info">
          <text class="contact-name" style="font-weight: bold; font-size: 30rpx;">{{item.name}}</text>
          <text class="contact-label" style="font-size: 24rpx; color: #666; margin-left: 10rpx;">金牌顾问</text>
        </view>
        <button class="btn-contact" bindtap="callContact" data-phone="{{item.phone}}" size="mini" style="margin: 0; font-size: 24rpx;">
          📞 立即咨询
        </button>
      </view>
    </view>
  </view>
</view>
