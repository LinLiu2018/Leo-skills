/* pages/index/index.wxss */
.container {
  padding-bottom: 120rpx;
}

/* Banner */
.banner {
  position: relative;
  height: 400rpx;
  overflow: hidden;
}

.banner-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #ff6b35 0%, #ff8f5e 100%);
}

.gift-emoji {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.banner-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 40rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
  color: #fff;
}

.banner-title {
  font-size: 48rpx;
  font-weight: bold;
  display: block;
}

.banner-subtitle {
  font-size: 28rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

/* 限时挑战 Banner */
.challenge-banner {
  background: linear-gradient(90deg, #fff0e6 0%, #fff9f2 100%);
  border: 1rpx solid #ffd8c2;
  border-radius: 12rpx;
  margin: -40rpx 24rpx 24rpx; /* 向上重叠一点 */
  padding: 20rpx;
  display: flex;
  align-items: center;
  position: relative;
  z-index: 11; /* 比Highlights高 */
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 53, 0.1);
}

.challenge-icon {
  width: 60rpx;
  height: 60rpx;
  margin-right: 20rpx;
}

.challenge-content {
  flex: 1;
}

.challenge-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #ff6b35;
}

.challenge-desc {
  display: block;
  font-size: 22rpx;
  color: #995232;
  margin-top: 4rpx;
}

.challenge-timer {
  font-size: 24rpx;
  color: #ff6b35;
  background: rgba(255, 107, 53, 0.1);
  padding: 8rpx 16rpx;
  border-radius: 24rpx;
}

/* 实时动态 (Bar样式) */
.dynamics-bar {
  display: flex;
  align-items: center;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 30rpx;
  padding: 8rpx 20rpx;
  margin: 0 24rpx 24rpx;
  color: #fff;
  font-size: 24rpx;
}

.dynamics-icon {
  margin-right: 12rpx;
}

.dynamics-swiper {
  flex: 1;
}

.dynamics-text {
  display: flex;
  align-items: center;
  height: 100%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.dynamics-text .highlight {
  color: #ffd700;
  font-weight: bold;
  margin: 0 6rpx;
}

/* 项目亮点 (调整margin) */
.highlights {
  display: flex;
  background: #fff;
  padding: 30rpx 0;
  margin: 0 24rpx 0; /* 取消负margin，因为被Challenge Banner替代 */
  border-radius: 16rpx;
  position: relative;
  z-index: 10;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.highlight-item {
  flex: 1;
  text-align: center;
  border-right: 1rpx solid #eee;
}

.highlight-item:last-child {
  border-right: none;
}

.highlight-value {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #ff6b35;
}

.highlight-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 产品介绍 (图片化) */
.product-intro {
  margin-top: 24rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  padding-left: 20rpx;
  border-left: 8rpx solid #ff6b35;
  margin-bottom: 30rpx;
  line-height: 1;
}

.intro-item {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.intro-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.intro-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
  background: #f5f5f5;
}

.intro-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

/* 视频展示 */
.video-section {
  margin-top: 24rpx;
}

.project-video {
  width: 100%;
  height: 400rpx;
  border-radius: 16rpx;
}

/* 图片展示 */
.gallery-section {
  margin-top: 24rpx;
}

.gallery-swiper {
  width: 100%;
  height: 400rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.gallery-image {
  width: 100%;
  height: 100%;
}

/* 礼品区域 (网格化) */
.gift-section {
  margin-top: 24rpx;
}

.gift-header-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 16rpx;
}

/* 礼品可以横向滚动 */
.gift-grid {
  display: flex;
  overflow-x: auto;
  padding: 10rpx 0 20rpx;
  margin: 0 -10rpx;
  -webkit-overflow-scrolling: touch;
}

.gift-card {
  flex: 0 0 200rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 16rpx 20rpx;
  text-align: center;
  margin: 0 10rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid #f0f0f0;
  transition: all 0.2s ease;
}

.gift-card:active {
  transform: scale(0.98);
}

.gift-card.claimed {
  opacity: 0.6;
  background: #fafafa;
}

.gift-card.unlocked {
  border-color: #52c41a;
  background: linear-gradient(180deg, #f6fff6 0%, #fff 100%);
}

.gift-img-wrapper {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  margin: 0 auto 16rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #f8f8f8 0%, #f0f0f0 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.gift-card-img {
  width: 100%;
  height: 120rpx;
  transition: all 0.3s ease;
}

.gift-status-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.3);
}

.status-badge {
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: #fff;
}

.status-badge.claimed {
  background: rgba(0, 0, 0, 0.5);
}

.status-badge.unlocked {
  background: #52c41a;
}

.gift-name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.3;
}

.gift-condition {
  display: inline-block;
  font-size: 20rpx;
  color: #ff6b35;
  background: rgba(255, 107, 53, 0.1);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

/* 礼品进度条 */
.gift-progress-mini {
  margin-top: 12rpx;
}

.progress-track {
  height: 6rpx;
  background: #eee;
  border-radius: 3rpx;
  overflow: hidden;
  margin-bottom: 4rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #ff6b35, #ff8f5e);
  border-radius: 3rpx;
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 18rpx;
  color: #999;
}

/* 领取按钮 */
.btn-claim {
  width: 100%;
  height: 96rpx;
  /* line-height: 96rpx; Removed in favor of flex */
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  background: linear-gradient(135deg, #ff6b35 0%, #ff8f5e 100%);
  color: #fff;
  border-radius: 48rpx;
  font-size: 34rpx;
  font-weight: 500;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 53, 0.4);
}

.btn-claim::after {
  border: none;
}

/* 已领取状态 */
.claimed-info {
  text-align: center;
}

.claimed-success {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #52c41a;
  margin-bottom: 16rpx;
}

.success-icon {
  margin-right: 8rpx;
}

.claimed-tip {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 24rpx;
}

.btn-share {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #ff6b35 0%, #ff8f5e 100%);
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  border: none;
}

.btn-share::after {
  border: none;
}

/* 实时动态 */
.dynamics {
  margin-top: 24rpx;
}

.dynamics-header {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
  font-weight: 500;
}

.dynamics-list {
  max-height: 200rpx;
  overflow: hidden;
}

.dynamics-item {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #666;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.dynamics-item:last-child {
  border-bottom: none;
}

.dynamics-time {
  color: #999;
}

/* 咨询入口 */
.contact {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
}

.contact-info {
  display: flex;
  flex-direction: column;
}

.contact-label {
  font-size: 24rpx;
  color: #999;
}

.contact-name {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
  margin-top: 4rpx;
}

.btn-contact {
  background: linear-gradient(135deg, #ff6b35 0%, #ff8f5e 100%);
  color: #fff;
  font-size: 28rpx;
  padding: 10rpx 30rpx;
  border-radius: 40rpx;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 53, 0.3);
}

.btn-contact::after {
  border: none;
}

/* 分享引导区域 */
.share-guide {
  margin-top: 20rpx;
  text-align: center;
}

.btn-test {
  margin-top: 20rpx !important;
  background: #f5f5f5 !important;
  color: #999 !important;
  font-size: 22rpx !important;
}

.gift-count {
  margin-left: auto;
  font-size: 24rpx;
  color: #ff6b35;
  background: rgba(255, 107, 53, 0.1);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.gift-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
