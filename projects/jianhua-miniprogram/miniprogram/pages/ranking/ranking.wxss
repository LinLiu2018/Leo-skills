/* pages/ranking/ranking.wxss */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 160rpx;
}

/* 顶部背景 */
.header-bg {
  background: linear-gradient(135deg, #FF6B35 0%, #ff8f5e 100%);
  padding: 60rpx 30rpx 120rpx;
}

.header-content {
  text-align: center;
  color: #fff;
}

.header-title {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.header-desc {
  display: block;
  font-size: 28rpx;
  opacity: 0.9;
}

/* 我的排名卡片 */
.my-rank-card {
  display: flex;
  align-items: center;
  background: #fff;
  margin: -60rpx 24rpx 24rpx;
  padding: 30rpx;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 53, 0.2);
  position: relative;
  z-index: 10;
}

.my-rank-left,
.my-rank-right {
  text-align: center;
}

.my-rank-left {
  width: 140rpx;
}

.my-rank-label,
.my-invite-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.my-rank-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #FF6B35;
}

.my-rank-center {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.my-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 4rpx solid #FF6B35;
  margin-bottom: 12rpx;
}

.my-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.my-rank-right {
  width: 140rpx;
}

.my-invite-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #FF6B35;
}

.my-invite-unit {
  font-size: 24rpx;
  color: #FF6B35;
  margin-left: 4rpx;
}

/* 排行榜列表 */
.rank-list {
  margin: 0 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 0 24rpx;
}

.rank-header {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 24rpx;
  color: #999;
}

.rank-col {
  width: 100rpx;
  text-align: center;
}

.rank-col.user {
  flex: 1;
  text-align: left;
  padding-left: 20rpx;
}

.rank-col.count {
  width: 120rpx;
  text-align: right;
}

/* 排行项 */
.rank-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.rank-item:last-child {
  border-bottom: none;
}

.rank-item.top-1 {
  background: linear-gradient(90deg, rgba(255, 215, 0, 0.1) 0%, transparent 100%);
}

.rank-item.top-2 {
  background: linear-gradient(90deg, rgba(192, 192, 192, 0.1) 0%, transparent 100%);
}

.rank-item.top-3 {
  background: linear-gradient(90deg, rgba(205, 127, 50, 0.1) 0%, transparent 100%);
}

.rank-num {
  width: 100rpx;
  text-align: center;
}

.rank-medal {
  font-size: 40rpx;
}

.rank-number {
  font-size: 32rpx;
  color: #999;
  font-weight: 500;
}

.rank-user {
  flex: 1;
  display: flex;
  align-items: center;
}

.rank-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.rank-name {
  font-size: 28rpx;
  color: #333;
}

.rank-count {
  width: 120rpx;
  text-align: right;
}

.count-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #FF6B35;
}

.count-unit {
  font-size: 24rpx;
  color: #999;
  margin-left: 4rpx;
}

/* 底部提示 */
.bottom-tip {
  text-align: center;
  padding: 30rpx;
  font-size: 24rpx;
  color: #999;
}

/* 分享按钮 */
.share-btn-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.btn-share {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FF6B35 0%, #ff8f5e 100%);
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 53, 0.4);
}

.btn-share::after {
  border: none;
}
