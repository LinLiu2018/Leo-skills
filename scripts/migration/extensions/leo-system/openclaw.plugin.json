{
  "id": "leo-system",
  "name": "Leo System Integration",
  "version": "1.0.0",
  "description": "Integrates Leo AI System with OpenClaw",
  "main": "./index.js",
  "openclaw": {
    "extensions": ["./index.js"]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "mcpServerPath": {
        "type": "string",
        "description": "Path to Leo MCP Server Python script"
      },
      "enabled": {
        "type": "boolean",
        "description": "Enable Leo System integration"
      }
    }
  },
  "uiHints": {
    "mcpServerPath": {
      "label": "MCP Server Path",
      "placeholder": "D:/桌面/leo_ai_system/.mcp/leo_mcp_server.py"
    },
    "enabled": {
      "label": "Enable Integration"
    }
  }
}
