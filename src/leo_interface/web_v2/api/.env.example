# Copy to .env and fill values for local/production use.
ZHIPU_API_KEY=
MINIMAX_API_KEY=
OPENAI_API_KEY=
REVIEW_PLATFORM_API_KEY=
WECHAT_VIDEO_API_KEY=
SECRET_KEY=change-this-in-production

# Legacy single token (admin fallback)
LEO_WEB_API_TOKEN=

# Recommended: JSON token registry (production)
# Example: [{"token":"prod-admin-token","role":"admin","principal":"ops-admin"},{"token":"prod-exec-token","role":"executor","principal":"ui-executor"}]
LEO_WEB_API_TOKENS=[]

# If true, read APIs also require token
LEO_WEB_API_REQUIRE_READ_TOKEN=false

# Rate limits per principal per minute
LEO_WEB_RATE_LIMIT_WRITE_PER_MIN=60
LEO_WEB_RATE_LIMIT_EXECUTE_PER_MIN=120
